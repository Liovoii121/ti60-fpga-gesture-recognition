# DDR core/UI timing inherited from the baseline controller. Async PHY controls
# and clocks are not part of the application video clock relationship.
set_clock_groups -asynchronous -group {tdqss_clk core_clk tac_clk twd_clk}
set_max_delay -from [get_clocks core_clk] -to [get_clocks clk_sys] 4.5
set_max_delay -from [get_clocks clk_sys] -to [get_clocks core_clk] 4.5
set_false_path -from [get_clocks tac_clk] -to [get_clocks clk_sys]
set_false_path -from [get_clocks twd_clk] -to [get_clocks clk_sys]
set_false_path -from [get_clocks clk_sys] -to [get_clocks tac_clk]
set_false_path -from [get_clocks clk_sys] -to [get_clocks twd_clk]
set_false_path -from [get_clocks twd_clk] -to [get_clocks core_clk]
# MIPIRx4LaneFre crosses an asynchronous byte clock using its FIFO.
set_false_path -from [get_clocks clk_sys] -to [get_clocks csi_rxc_i]
set_false_path -from [get_clocks csi_rxc_i] -to [get_clocks clk_sys]

# Read-only diagnostic scan, host TCK <= 1 MHz. Multi-cycle settled snapshot bus.
set_clock_groups -asynchronous -group {diag_tck}

# STATIC11_CNN_ACTUAL_MAP_FIFO_GRAY: inherited bounds, actual mapped capture cells.


# LEGACY_UI_RESTORE_NAMED_SYNCHRONIZERS
# Each exception targets only the first synchronizer D input. No image-domain
# data path or complete clock domain is excluded by these additions.
set_false_path -to [get_pins {history_ids_meta*|D}]
set_false_path -to [get_pins {panel_control_meta*|D}]
set_false_path -to [get_pins {gesture_display_meta*|D}]
