set_false_path -to [get_pins {color_adjust/sync_toggle[0]~FF|D}]

# Read-only diagnostic snapshot: stable color mailbox is host-acknowledged;
# free-running counters are observational and may span adjacent sample instants.
set_false_path -from [get_clocks clk_pixel] -to [get_pins {dscan/snapshot*|D}]
# FIFO vendor asynchronous reset-assert stage; deassertion is internally synchronized.
set_false_path -from [get_clocks clk_sys] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/genblk2.rd_rst*|SR}]

set_false_path -to [get_pins {video_ready_sync[0]~FF|D}]

# Remaining vendor reset-assert pins crossing reset domains. Release is filtered
# by the FIFO reset pipeline and read scheduler settling delay.
set_false_path -from [get_clocks clk_sys] -to [get_pins {u_axi4_ctrl/rfifo_rst~FF|SR}]
set_false_path -from [get_clocks clk_pixel] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/genblk2.wr_rst*|SR}]
# First sampling stage for FIFO reset; downstream settling counter is timed normally.
set_false_path -from [get_clocks clk_pixel] -to [get_pins {u_axi4_ctrl/r_rfifo_rst~FF|D}]

# Pixel reset synchronizer: asynchronous assertion, synchronous release.
set_false_path -from [get_clocks clk_sys] -to [get_pins {u_axi4_ctrl/read_reset_sync*|SR}]
# Vendor RAW8 FIFO Gray-pointer buses terminate at two-stage CDC synchronizers.
# Bound flight time/skew below the faster clock period; time same-domain stages normally.
set_max_delay -from [get_clocks clk_pixel] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/xefx_fifo_ctl/genblk7.xrd2wr_addr_sync/*|D}] 2.000
set_false_path -hold -from [get_clocks clk_pixel] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/xefx_fifo_ctl/genblk7.xrd2wr_addr_sync/*|D}]
set_max_delay -from [get_clocks clk_sys] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/xefx_fifo_ctl/genblk7.wr2rd_addr_sync/*|D}] 2.000
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {u_axi4_ctrl/Gen_RFIFO_16.u_R0_FIFO_16/u_efx_fifo_top/xefx_fifo_ctl/genblk7.wr2rd_addr_sync/*|D}]
# Additional first-stage synchronizer only for lane 1 color mailbox.
set_false_path -to [get_pins {color_adjust1/sync_toggle[0]~FF|D}]
# Boot flash handoff crosses into the pixel domain through two preserved stages.
# Exclude only the asynchronous input to stage 0; stage 0 -> stage 1 remains timed.
set_false_path -from [get_clocks clk_sys] -to [get_pins {boot_pin_owner/released_pixel[0]~FF|D}]

# FPS monitor: request/ack handshake, coherent held mailbox (>=2 sys clocks stable).
set_false_path -to [get_pins {fps_monitor/req_sync[0]~FF|D}]
set_false_path -to [get_pins {fps_monitor/ack_sync[0]~FF|D}]
set_false_path -to [get_pins {fps_monitor/camera_sync[0]~FF|D}]
# Source identity is selected in vertical blank and sampled at first active pixel.
set_false_path -to [get_pins {fps_monitor/id_meta*|D}]
set_max_delay -from [get_clocks clk_pixel] -to [get_pins {fps_status*|D}] 4.000
set_false_path -hold -from [get_clocks clk_pixel] -to [get_pins {fps_status*|D}]

# Pixel-statistics producer holds a complete frame record for milliseconds.
# Toggle passes two synchronizer stages before the 96MHz consumer copies data.
# Bound the bundled bus below one destination cycle; do not exclude pixel logic.

# Audio output routing budgets; physical amplifier timing remains a board test.
set_output_delay -clock [get_clocks {clk_pixel}] -max 0 [get_ports {amp_bclk amp_lrclk amp_din}]
set_output_delay -clock [get_clocks {clk_pixel}] -min 0 [get_ports {amp_bclk amp_lrclk amp_din}]
set_max_delay 20 -from [get_clocks {clk_pixel}] -to [get_ports {amp_bclk amp_lrclk amp_din}]
set_min_delay 0 -from [get_clocks {clk_pixel}] -to [get_ports {amp_bclk amp_lrclk amp_din}]

# Audio/Canny LCD status crosses a true two-flop synchronizer.
# Exclude only asynchronous arrival at stage 0, keep stage 0 -> 1 timed.
set_false_path -to [get_pins {feature_meta*|D}]

# First stage only: diagnostic audio isolation mode CDC.
set_false_path -to [get_pins {audio_mode_meta*|D}]
# Continuous recognizer CDC: only asynchronous arrival at the first stage is cut.
# All later stages and arithmetic remain timed at their actual clock rates.
set_false_path -to [get_pins {continuous_recognition/key_sync[0]~FF|D}]
set_false_path -to [get_pins {continuous_recognition/cancel_sync[0]~FF|D}]
set_false_path -to [get_pins {continuous_recognition/record_sync[0]~FF|D}]
set_false_path -to [get_pins {continuous_recognition/stopped_sync[0]~FF|D}]
set_false_path -to [get_pins {continuous_recognition/error_sync[0]~FF|D}]
set_false_path -to [get_pins {nn_audio_sync[0]~FF|D}]
set_false_path -to [get_pins {nn_ui_sync[0]~FF|D}]
# Gray pointers: each bit arrives in less than one source clock period.
set_max_delay 4.000 -from [get_clocks clk_pixel] -to [get_pins {continuous_recognition/fifo/wg1*|D}]
set_false_path -hold -from [get_clocks clk_pixel] -to [get_pins {continuous_recognition/fifo/wg1*|D}]
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {continuous_recognition/fifo/rg1*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {continuous_recognition/fifo/rg1*|D}]
# Stable result mailbox: source data precedes a three-stage synchronized toggle.
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {nn_panel_*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {nn_panel_*|D}]
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {nn_audio_count*|D nn_audio_words*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {nn_audio_count*|D nn_audio_words*|D}]
# Display-bank identity is held for a read frame; prefetch selects it in blanking.
# Bound first-stage arrival, then time source_meta -> source_sync normally.
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {continuous_recognition/source_meta*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {continuous_recognition/source_meta*|D}]
# Only the reset-assert inputs of the local pixel reset synchronizer cross clocks.
# Release is synchronized; functional pixel-domain state is not excluded.
set_false_path -from [get_clocks clk_sys] -to [get_pins {continuous_recognition/pixel_reset_sync*|SR}]

# HDMI-only result mailbox: stable data plus synchronized 3FF toggle.
set_false_path -to [get_pins {nn_hdmi_sync[0]~FF|D}]
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {nn_hdmi_state*|D nn_hdmi_count*|D nn_hdmi_words*|D nn_hdmi_accepted*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {nn_hdmi_state*|D nn_hdmi_count*|D nn_hdmi_words*|D nn_hdmi_accepted*|D}]

# Rate window uses held sys-domain counters plus one toggle per second.
set_false_path -to [get_pins {rate_sync[0]~FF|D}]
set_max_delay 4.000 -from [get_clocks clk_sys] -to [get_pins {rate_pixel_camera*|D rate_pixel_output*|D rate_pixel_valid*|D}]
set_false_path -hold -from [get_clocks clk_sys] -to [get_pins {rate_pixel_camera*|D rate_pixel_output*|D rate_pixel_valid*|D}]

# Unified recognizer: asynchronous status inputs only; next-stage paths remain timed.
set_false_path -to [get_pins {nn_flags_meta*|D}]

set_false_path -to [get_pins {touch_display/mode_sync[0]~FF|D}]
