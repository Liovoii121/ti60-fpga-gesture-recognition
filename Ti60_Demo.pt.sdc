set_false_path -to [get_pins {u_axi4_ctrl/compare_axi_sync[0]~FF|D}]
set_false_path -to [get_pins {u_axi4_ctrl/freeze_cam_sync[0]~FF|D}]
set_false_path -to [get_pins {u_axi4_ctrl/hold_axi_sync[0]~FF|D}]
